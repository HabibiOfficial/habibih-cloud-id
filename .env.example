# ── Server ────────────────────────────────────────────────
# Port lokal yang dipakai proses web ini
PORT=8080

# Host yang di-bind. WAJIL 0.0.0.0 di produksi/VPS.
HOST=0.0.0.0

# ── Upstream ──────────────────────────────────────────────
# Alamat backend HABI API yang sudah jalan.
# Kalau web & API di server yang sama -> http://127.0.0.1:3000
UPSTREAM_API=http://140.245.32.37:3000

# Timeout upstream dalam milidetik (default 180000 = 3 menit)
UPSTREAM_TIMEOUT_MS=180000

# ── URL Publik ───────────────────────────────────────────
# Domain yang dipakai di contoh kode & tombol tester.
# WAJIB diisi di produksi, mis: https://api.domain-kamu.com
# Kalau kosong, otomatis pakai domain sesuai permintaan.
SITE_PUBLIC_URL=

# ── Identitas (ditampilkan di landing page & docs) ────────
SITE_NAME=HABI API
SITE_TAGLINE=Downloader & Tools REST API
OWNER_NAME=Habibih Cloud Official ID
OWNER_WA=6285181576338
OWNER_WEBSITE=https://habibi-store.pages.dev
SUPPORT_WA=6285181576338

# Link grup komunitas
GROUP_LINK=https://chat.whatsapp.com/L8UUutSeDK68LsHf0SXekh

# Kuota default yang diumumkan user (harus sama dengan backend)
FREE_QUOTA_TEXT=25 req/hari

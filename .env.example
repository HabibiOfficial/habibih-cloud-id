# =========================================================
#  Contoh konfigurasi — salin jadi .env lalu isi
#  cp .env.example .env
#
#  File .env TIDAK ikut ter-commit ke Git (sudah di .gitignore).
# =========================================================

# ── Server ──
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# ── Backend REST API (penyedia API key) ──
# Dipakai untuk validasi apikey dan meneruskan endpoint yang
# tidak dijalankan lokal. Kosongkan hanya kalau kamu tidak butuh
# endpoint dari backend.
UPSTREAM_API=http://127.0.0.1:3000
UPSTREAM_TIMEOUT_MS=180000

# ── Identitas situs (dikirim ke frontend lewat /config) ──
SITE_NAME=HABI API
SITE_TAGELINE=Downloader & Tools REST API
SITE_PUBLIC_URL=https://api.domain-kamu.com
OWNER_NAME=Habibih Cloud Official ID
OWNER_WA=6285181576338
OWNER_WEBSITE=https://habibi-store.pages.dev
SUPPORT_WA=6285181576338
GROUP_LINK=
FREE_QUOTA_TEXT=25 req/hari

# ── yt-dlp ──
# Kalau binary tidak ada di PATH, taruh path absolut di sini.
YTDLP_PATH=/usr/local/bin/yt-dlp
YTDLP_TIMEOUT_MS=120000
# LOG_NATIVE=1   # nyalakan log timing tiap request

# ── Keamanan (opsional) ──
# Batas ukuran gambar yang boleh diambil endpoint gambar.
# MAX_IMAGE_BYTES=8388608          # 8 MB
# Batas ukuran file untuk /api/file.
# MAX_BINARY_BYTES=52428800        # 50 MB
# Timeout saat menarik gambar dari URL.
# IMAGE_FETCH_TIMEOUT_MS=15000

# ── Cookie platform (opsional, hanya di server) ──
# Format file: Netscape cookies.txt. JANGAN pernah di-commit.
# Instagram memblokir request anonim — tanpa cookie, /api/instagram
# akan membalas 400 dengan pesan yang jelas.
# HABI_INSTAGRAM_COOKIES=/home/deploy/cookies/instagram.txt
# HABI_TIKTOK_COOKIES=/home/deploy/cookies/tiktok.txt

# ── Gateway fallback (opsional, hanya di server) ──
# Dipakai HANYA kalau yt-dlp dan tikwm sama-sama gagal.
# Simpan di .env, jangan tulis di kode.
# HABI_TIKTOK_KEY=
# HABI_FACEBOOK_KEY=
# HABI_GENCIPTA_KEY=
